# ============================================================
# VaultIQ Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=5000

# JWT Secret — use a long random string (min 32 chars)
JWT_SECRET=

# AES-256 Encryption Key — must be exactly 64 hex characters (32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=

# Hadoop HDFS — WebHDFS REST endpoint
HDFS_WEBHDFS_URL=http://localhost:9870/webhdfs/v1

# AI Service (FastAPI)
AI_SERVICE_URL=http://localhost:8001
