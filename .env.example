# VaultIQ — Global Environment Configuration

# -- Backend API --
PORT=5000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key
ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f # 32 bytes in hex

# -- Supabase (Metadata & Auth) --
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_key

# -- AWS S3 (Storage) --
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=vaultiq-docs

# -- Infrastructure --
HDFS_WEBHDFS_URL=http://namenode:9870
AI_SERVICE_URL=http://ai-service:8001
REDIS_URL=redis://redis:6379

# -- Database (Local Postgres) --
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vaultiq
DATABASE_URL=postgresql://postgres:postgres@db:5432/vaultiq
